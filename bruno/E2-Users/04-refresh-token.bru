meta {
  name: 04 - Refresh Token
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/token/refresh/
  body: json
  auth: none
}

body:json {
  {
    "refresh": "{{refresh_token}}"
  }
}

tests {
  test("Refresh - 200", function() {
    expect(res.getStatus()).to.equal(200);
    bru.setVar("token", res.getBody().access);
  });
}
