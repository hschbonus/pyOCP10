meta {
  name: 07 - Update User
  type: http
  seq: 7
}

patch {
  url: {{base_url}}/api/users/{{user_id}}/
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "email": "user_e2_updated@test.com"
  }
}

tests {
  test("Update user - 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().email).to.equal("user_e2_updated@test.com");
  });
}
