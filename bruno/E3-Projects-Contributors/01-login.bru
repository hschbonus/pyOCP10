meta {
  name: 01 - Login
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/token/
  body: json
  auth: none
}

body:json {
  {
    "username": "{{admin_username}}",
    "password": "{{admin_password}}"
  }
}

tests {
  test("Login - 200", function() {
    expect(res.getStatus()).to.equal(200);
    bru.setVar("token", res.getBody().access);
  });
}
