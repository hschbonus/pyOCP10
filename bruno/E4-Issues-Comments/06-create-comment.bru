}

post {
  url: {{base_url}}/api/comments/
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "description": "Je confirme ce bug sur mobile",
    "issue": {{issue_id}}
  }
}

tests {
  test("Create comment - 201", function() {
    expect(res.getStatus()).to.equal(201);
    bru.setVar("comment_id", res.getBody().id);
  });
}
