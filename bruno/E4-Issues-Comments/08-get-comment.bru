meta {
  name: 08 - Get Comment
  type: http
  seq: 8
}

get {
  url: {{base_url}}/api/comments/{{comment_id}}/
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Get comment - 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("description");
    expect(res.getBody()).to.have.property("uuid");
  });
}
