meta {
  name: 01 - List Projects (Charlie - non contributeur)
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/projects/
  body: none
  auth: bearer
}

auth:bearer {
  token: {{charlie_token}}
}

tests {
  test("Non contributeur - liste vide - 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("results").that.is.an("array").with.lengthOf(0);
    expect(res.getBody()).to.have.property("count").that.equals(0);
  });
}
