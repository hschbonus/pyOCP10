meta {
  name: 01 - List Projects (Bob - contributeur)
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/projects/
  body: none
  auth: bearer
}

auth:bearer {
  token: {{bob_token}}
}

tests {
  test("Contributeur - list - 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.have.property("results").that.is.an("array").with.lengthOf(1);
    expect(res.getBody()).to.have.property("count").that.equals(1);
  });
}
